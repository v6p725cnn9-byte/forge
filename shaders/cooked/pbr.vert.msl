#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Camera
{
    float4x4 view_projection;
    float4x4 model;
};

struct main0_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float3 out_var_TEXCOORD1 [[user(locn1)]];
    float4 out_var_TEXCOORD2 [[user(locn2)]];
    float2 out_var_TEXCOORD3 [[user(locn3)]];
    float2 out_var_TEXCOORD4 [[user(locn4)]];
    float4 out_var_TEXCOORD5 [[user(locn5)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float4 in_var_TEXCOORD2 [[attribute(2)]];
    float2 in_var_TEXCOORD3 [[attribute(3)]];
    float2 in_var_TEXCOORD4 [[attribute(4)]];
    float4 in_var_TEXCOORD5 [[attribute(5)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_Camera& Camera [[buffer(0)]])
{
    main0_out out = {};
    float4 _50 = Camera.model * float4(in.in_var_TEXCOORD0, 1.0);
    out.gl_Position = Camera.view_projection * _50;
    out.out_var_TEXCOORD0 = _50.xyz;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD1 * float3x3(float4(Camera.model[0][0], Camera.model[1][0], Camera.model[2][0], Camera.model[3][0]).xyz, float4(Camera.model[0][1], Camera.model[1][1], Camera.model[2][1], Camera.model[3][1]).xyz, float4(Camera.model[0][2], Camera.model[1][2], Camera.model[2][2], Camera.model[3][2]).xyz);
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD3 = in.in_var_TEXCOORD3;
    out.out_var_TEXCOORD4 = in.in_var_TEXCOORD4;
    out.out_var_TEXCOORD5 = in.in_var_TEXCOORD5;
    return out;
}

